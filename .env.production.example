AFTERTONE_ENV=production
AFTERTONE_WEB_ORIGIN=https://aftrtone.angerz.dev
# Generate with: cd backend && .venv/bin/python -m app.auth
# Keep the value single-quoted: Compose and shell must preserve Argon2's dollar signs.
AFTERTONE_OWNER_PASSWORD_HASH=''
AFTERTONE_SESSION_SECONDS=43200
AFTERTONE_DATABASE_URL=sqlite:////data/aftertone.sqlite3
AFTERTONE_COVER_DIR=/data/covers
AFTERTONE_BACKUP_HOST_DIR=./backups
AFTERTONE_MUSICBRAINZ_CONTACT=https://github.com/Angerz/aftertone
