# Bind only to localhost. Change these if they collide with another local app.
AFTERTONE_API_HOST=127.0.0.1
AFTERTONE_API_PORT=8017
AFTERTONE_WEB_HOST=127.0.0.1
AFTERTONE_WEB_PORT=5177
AFTERTONE_WEB_ORIGIN=http://127.0.0.1:5177
AFTERTONE_DATABASE_URL=sqlite:///./aftertone.sqlite3
AFTERTONE_COVER_DIR=./data/covers
# Owner authentication is required for writes in development too.
# Generate a hash with: cd backend && .venv/bin/python -m app.auth
# Single quotes preserve the dollar signs when this file is sourced.
AFTERTONE_ENV=development
AFTERTONE_OWNER_PASSWORD_HASH=''
AFTERTONE_SESSION_SECONDS=43200
# Never place credentials in VITE_* variables (they become public bundle content).
